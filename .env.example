# NapCat OneBot V11 反向 WebSocket 配置
HOST=127.0.0.1
PORT=8080
ONEBOT_V11_ACCESS_TOKEN=change-this-token
COMMAND_START=/
QQBOT_DATABASE_PATH=data/qqbot.db
# Optional: path to the old Python plugins/cp_pairing/cp_history.json
QQBOT_CP_HISTORY_PATH=
QQBOT_ADMIN_IDS=
QQBOT_FORBIDDEN_WORDS=
QQBOT_FORBIDDEN_MUTE_SECONDS=60
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=600
# PNG 图片生成使用的中文 TTF/TTC 字体；Windows 默认尝试系统字体
QQBOT_FONT_PATH=
